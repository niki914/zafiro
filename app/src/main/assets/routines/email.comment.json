{
 "id": "email.comment",
 "version": 1,
 "platform": "email",
 "description": "On the post currently open in Email (Gmail), write a comment and send it. Only after an engage gate of AUTO or owner approval.",
 "params": [
  {
   "name": "text",
   "required": true
  }
 ],
 "steps": [
  {
   "op": "tap",
   "labels": [
    "Reply"
   ],
   "timeout_s": 6
  },
  {
   "op": "type",
   "labels": [
    "Compose email",
    "Subject",
    "To"
   ],
   "text": "{text}"
  },
  {
   "op": "tap",
   "labels": [
    "Send"
   ],
   "timeout_s": 8
  }
 ]
}
