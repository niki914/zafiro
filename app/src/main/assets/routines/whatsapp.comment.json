{
 "id": "whatsapp.comment",
 "version": 1,
 "platform": "whatsapp",
 "description": "On the post currently open in WhatsApp, write a comment and send it. Only after an engage gate of AUTO or owner approval.",
 "params": [
  {
   "name": "text",
   "required": true
  }
 ],
 "steps": [
  {
   "op": "tap",
   "labels": [
    "Reply"
   ],
   "timeout_s": 6
  },
  {
   "op": "type",
   "labels": [
    "Message",
    "Type a message"
   ],
   "text": "{text}"
  },
  {
   "op": "tap",
   "labels": [
    "Send"
   ],
   "timeout_s": 8
  }
 ]
}
