{
 "id": "youtube.read_activity",
 "version": 1,
 "platform": "youtube",
 "description": "Open YouTube notifications/activity and return what is shown (replies, likes, mentions).",
 "params": [],
 "steps": [
  {
   "op": "open_app",
   "package": "com.google.android.youtube"
  },
  {
   "op": "tap",
   "labels": [
    "Notifications"
   ],
   "optional": true
  },
  {
   "op": "sleep",
   "ms": 1500
  },
  {
   "op": "collect",
   "count": 3
  }
 ]
}
