{
 "id": "tiktok.comment",
 "version": 1,
 "platform": "tiktok",
 "description": "On the post currently open in TikTok, write a comment and send it. Only after an engage gate of AUTO or owner approval.",
 "params": [
  {
   "name": "text",
   "required": true
  }
 ],
 "steps": [
  {
   "op": "tap",
   "labels": [
    "Add comment",
    "Comment"
   ],
   "timeout_s": 6
  },
  {
   "op": "type",
   "labels": [
    "Describe your post",
    "Add description"
   ],
   "text": "{text}"
  },
  {
   "op": "tap",
   "labels": [
    "Post",
    "Send"
   ],
   "timeout_s": 8
  }
 ]
}
